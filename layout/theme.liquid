<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="application-name" content="{{ settings.brand_name | default: shop.name | escape }}">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- unless settings.use_custom_fonts -%}
      {{ 'inter-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {%- liquid
      assign brand = settings.brand_name | default: shop.name
      assign seo_title = page_title
      if page_title == blank or page_title == shop.name
        assign seo_title = brand
      endif
    -%}
    <title>
      {{- seo_title -}}
      {%- if current_tags -%}{%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless seo_title contains brand %} &ndash; {{ brand }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- if template.name == 'search' or template.name == 'cart' or template.directory == 'customers' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          inStock: {{ 'products.product.in_stock' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          viewCart: {{ 'products.product.view_cart' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          discountInvalid: {{ 'cart.discount.invalid' | t | json }},
          salePercent: {{ 'products.badges.sale_percent' | t: percent: '[percent]' | json }},
          saleText: {{ 'products.badges.sale_text' | t | json }},
          searchNoResults: {{ 'search.predictive.no_results' | t: terms: '[terms]' | json }},
          loading: {{ 'general.loading' | t | json }}
        },
        saleBadgeStyle: {{ settings.sale_badge_style | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.animations_reveal %} has-reveal{% endif %}">
    <a class="skip-link button" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    <div class="toast" id="ThemeToast" role="status" aria-live="polite" aria-atomic="true" hidden></div>

    <ul hidden>
      <li id="a11y-new-window">{{ 'accessibility.link_opens_new_window' | t }}</li>
    </ul>
  </body>
</html>
