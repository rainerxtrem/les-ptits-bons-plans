{%- layout none -%}
{%- assign initial_value = gift_card.initial_value | money -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.title' | t: value: initial_value }} — {{ settings.brand_name | default: shop.name }}</title>
    <meta name="robots" content="noindex, nofollow">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="password-page">
      <div class="password-page__inner contact-card" style="background: var(--color-bg);">
        <p class="eyebrow" style="justify-content: center;">{{ settings.brand_name | default: shop.name | escape }}</p>
        <h1 class="h2">{{ 'gift_card.heading' | t }}</h1>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="form-message form-message--error">{{ 'gift_card.unavailable' | t }}</p>
        {%- endif -%}
        <p class="h1" style="margin: 1rem 0;">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="text-muted">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
        {%- endif -%}
        {%- if gift_card.expires_on -%}
          {%- assign expiry = gift_card.expires_on | date: format: 'date' -%}
          <p class="text-muted small">{{ 'gift_card.expires_on' | t: date: expiry }}</p>
        {%- endif -%}
        <p style="margin-top: 1.5rem;">{{ 'gift_card.code_label' | t }}</p>
        <p class="pill" style="font-size: 1.1rem; letter-spacing: .1em; display: inline-block; padding: .6rem 1rem;">{{ gift_card.code | format_code }}</p>
        <div id="GiftCardQr" data-identifier="{{ gift_card.qr_identifier }}" style="display: grid; place-items: center; margin: 1.5rem 0;"></div>
        {%- if gift_card.pass_url -%}
          <p><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_card.apple_wallet' | t }}" loading="lazy" style="margin: 0 auto;"></a></p>
        {%- endif -%}
        <div style="display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; margin-top: 1rem;">
          <a href="{{ shop.url }}" class="button">{{ 'gift_card.shop_link' | t }}</a>
          <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
        </div>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('GiftCardQr');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
