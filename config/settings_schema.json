[
  {
    "name": "theme_info",
    "theme_name": "Les p'tits bons plans",
    "theme_version": "1.0.0",
    "theme_author": "Les p'tits bons plans",
    "theme_documentation_url": "https://github.com/rainerxtrem/les-ptits-bons-plans#readme",
    "theme_support_url": "https://github.com/rainerxtrem/les-ptits-bons-plans/issues"
  },
  {
    "name": "Logo et favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Si aucun logo n'est choisi, le nom de la boutique s'affiche en texte."
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Logo clair (pied de page sombre)",
        "info": "Facultatif. Utilisé sur les fonds foncés. À défaut, le logo principal est utilisé."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 5,
        "unit": "px",
        "label": "Largeur du logo sur ordinateur",
        "default": 170
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 50,
        "max": 220,
        "step": 5,
        "unit": "px",
        "label": "Largeur du logo sur mobile",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Image carrée de 32 × 32 px minimum."
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "header",
        "content": "Palette de la marque"
      },
      {
        "type": "color",
        "id": "color_sage",
        "label": "Vert sauge",
        "default": "#A8B5A2"
      },
      {
        "type": "color",
        "id": "color_sage_dark",
        "label": "Vert sauge foncé",
        "default": "#6E7F73"
      },
      {
        "type": "color",
        "id": "color_sage_light",
        "label": "Vert sauge très clair",
        "default": "#EDF0EA"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Or doux (accents décoratifs)",
        "default": "#C6A75E"
      },
      {
        "type": "color",
        "id": "color_gold_text",
        "label": "Or profond (petits textes)",
        "info": "Version plus foncée de l'or, lisible sur fond clair (contraste AA).",
        "default": "#84662A"
      },
      {
        "type": "color",
        "id": "color_ivory",
        "label": "Beige ivoire",
        "default": "#F7F5F0"
      },
      {
        "type": "color",
        "id": "color_offwhite",
        "label": "Blanc cassé",
        "default": "#FCFBF8"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Anthracite (texte)",
        "default": "#2E2E2E"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Texte secondaire",
        "default": "#5E5E5A"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordures et séparateurs",
        "default": "#E2DDD2"
      },
      {
        "type": "header",
        "content": "Boutons"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Bouton principal",
        "info": "Vert sauge foncé légèrement assombri pour garantir un contraste AA avec le texte blanc.",
        "default": "#5B6C60"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Texte du bouton principal",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "États et promotions"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Rouge doux (promotions)",
        "default": "#B04A3F"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Vert foncé (confirmations)",
        "default": "#3F6B4F"
      },
      {
        "type": "color",
        "id": "color_footer",
        "label": "Vert foncé (pied de page et fonds sombres)",
        "default": "#36433A"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "paragraph",
        "content": "Par défaut, le thème utilise les polices de la marque hébergées dans le thème : DM Serif Display pour les titres et Inter pour les textes."
      },
      {
        "type": "checkbox",
        "id": "use_custom_fonts",
        "label": "Remplacer les polices de la marque",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Police des titres",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police du texte",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 85,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Taille des titres",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "label": "Taille du texte",
        "default": 100
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Largeur maximale de la page",
        "default": 1360
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Arrondi des cartes et images",
        "default": 10
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Arrondi des boutons",
        "default": 40
      },
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Apparition discrète des sections au défilement",
        "info": "Désactivée automatiquement si le visiteur a demandé à réduire les animations.",
        "default": true
      }
    ]
  },
  {
    "name": "Cartes produit",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Format des images",
        "options": [
          { "value": "portrait", "label": "Portrait (4:5)" },
          { "value": "square", "label": "Carré (1:1)" },
          { "value": "landscape", "label": "Paysage (4:3)" }
        ],
        "default": "portrait"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Cadrage des images",
        "options": [
          { "value": "cover", "label": "Remplir le cadre" },
          { "value": "contain", "label": "Image entière (fond neutre)" }
        ],
        "default": "cover"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Afficher la deuxième image au survol (ordinateur)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Afficher la marque / le fournisseur",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Ajout rapide au panier",
        "info": "Uniquement pour les produits sans variantes et disponibles. Les autres affichent un lien « Choisir ».",
        "default": true
      },
      {
        "type": "select",
        "id": "sale_badge_style",
        "label": "Badge promotion",
        "options": [
          { "value": "percentage", "label": "Pourcentage calculé (ex. −20 %)" },
          { "value": "text", "label": "Texte « Bon plan »" }
        ],
        "default": "percentage"
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          { "value": "drawer", "label": "Tiroir latéral" },
          { "value": "page", "label": "Page panier" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Activer la note de commande",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_show_discount",
        "label": "Champ de code de réduction dans le panier",
        "info": "Les codes restent toujours saisissables à l'étape de paiement Shopify.",
        "default": true
      },
      {
        "type": "collection",
        "id": "cart_empty_collection",
        "label": "Collection suggérée quand le panier est vide"
      }
    ]
  },
  {
    "name": "Recherche",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Suggestions de recherche instantanées",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_price",
        "label": "Afficher le prix dans les suggestions",
        "default": true
      }
    ]
  },
  {
    "name": "Coordonnées",
    "settings": [
      {
        "type": "paragraph",
        "content": "Renseignez uniquement des informations exactes. Les champs vides ne sont pas affichés."
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "E-mail de contact"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Téléphone"
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Adresse"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Horaires du service client"
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "info": "https://instagram.com/…" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook", "info": "https://facebook.com/…" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok", "info": "https://tiktok.com/@…" },
      { "type": "text", "id": "social_pinterest_link", "label": "Pinterest", "info": "https://pinterest.com/…" },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube", "info": "https://youtube.com/…" },
      { "type": "text", "id": "social_linkedin_link", "label": "LinkedIn", "info": "https://linkedin.com/company/…" }
    ]
  },
  {
    "name": "Partage sur les réseaux",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image de partage par défaut",
        "info": "Utilisée lorsque la page n'a pas d'image propre (1200 × 628 px recommandé)."
      }
    ]
  }
]
