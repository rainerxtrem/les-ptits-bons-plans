<article class="section scheme-offwhite" style="--pad-top: 48px; --pad-bottom: 72px;">
  <div class="page-width page-width--narrow">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        <li aria-current="page">{{ article.title | escape }}</li>
      </ol>
    </nav>
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1>{{ article.title | escape }}</h1>
  </div>
  {%- if article.image -%}
    <div class="page-width page-width--medium">
      <div class="article-hero">
        {% render 'responsive-image', image: article.image, sizes: '(min-width: 1100px) 1100px, 100vw', priority: true %}
      </div>
    </div>
  {%- endif -%}
  <div class="page-width page-width--narrow">
    <div class="rte prose">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}
      <ul class="facets__pills" role="list" style="margin-top: 2rem;">
        {%- for tag in article.tags -%}
          <li><a class="pill" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <p style="margin-top: 2rem;"><a href="{{ blog.url }}" class="link-arrow">{{ 'blogs.back' | t: title: blog.title }} {% render 'icon', name: 'arrow-right', size: 16 %}</a></p>
  </div>
</article>
<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
