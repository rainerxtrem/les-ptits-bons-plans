<section class="section scheme-offwhite" style="--pad-top: 48px; --pad-bottom: 88px;">
  <div class="page-width page-width--medium">
    <p><a href="{{ routes.account_url }}" class="link-arrow">{{ 'customer.account.return' | t }}</a></p>
    <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>

    {%- paginate customer.addresses by 10 -%}
      <div class="grid" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: 2; margin-top: 1.5rem;">
        {%- for address in customer.addresses -%}
          <div class="contact-card">
            {%- if address == customer.default_address -%}<p class="badge badge--inline badge--new">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
            <div class="small">{{ address | format_address }}</div>
            <details style="margin-top: 1rem;">
              <summary class="link-button">{{ 'customer.addresses.edit' | t }}</summary>
              {%- form 'customer_address', address -%}
                {% render 'address-fields', form: form, prefix: address.id %}
                <button type="submit" class="button button--small">{{ 'customer.addresses.update' | t }}</button>
              {%- endform -%}
            </details>
            <form method="post" action="{{ address.url }}" style="margin-top: .5rem;">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="link-button" onclick="return confirm({{ 'customer.addresses.delete_confirm' | t | json | escape }});">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </div>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}

    <details class="contact-card" style="margin-top: 2rem;"{% if customer.addresses_count == 0 %} open{% endif %}>
      <summary class="h4" style="cursor: pointer;">{{ 'customer.addresses.add_new' | t }}</summary>
      {%- form 'customer_address', customer.new_address -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        {% render 'address-fields', form: form, prefix: 'new' %}
        <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Adresses", "tag": "div", "settings": [] }
{% endschema %}
