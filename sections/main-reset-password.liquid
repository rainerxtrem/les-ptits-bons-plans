<section class="section scheme-offwhite" style="--pad-top: 64px; --pad-bottom: 88px;">
  <div class="page-width">
    <div class="account-box">
      <h1 class="h2" style="text-align: center;">
        {%- if section.settings.form_type == 'activate' -%}{{ 'customer.activate.title' | t }}{%- else -%}{{ 'customer.reset.title' | t }}{%- endif -%}
      </h1>
      <p class="text-muted" style="text-align: center;">{{ 'customer.reset.subtext' | t }}</p>
      {%- if section.settings.form_type == 'activate' -%}
        {%- form 'activate_customer_password' -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {% render 'password-fields' %}
          <button type="submit" class="button button--full button--large" name="activate">{{ 'customer.activate.submit' | t }}</button>
          <button type="submit" class="button button--tertiary button--full" name="decline">{{ 'customer.activate.decline' | t }}</button>
        {%- endform -%}
      {%- else -%}
        {%- form 'reset_customer_password' -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {% render 'password-fields' %}
          <button type="submit" class="button button--full button--large">{{ 'customer.reset.submit' | t }}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe client",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "form_type",
      "label": "Formulaire",
      "options": [
        { "value": "reset", "label": "Réinitialisation" },
        { "value": "activate", "label": "Activation du compte" }
      ],
      "default": "reset"
    }
  ]
}
{% endschema %}
