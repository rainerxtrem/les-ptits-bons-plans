<section class="section scheme-offwhite" style="--pad-top: 64px; --pad-bottom: 88px;">
  <div class="page-width">
    <div class="account-box">
      <h1 class="h2" style="text-align: center;">{{ 'customer.login.title' | t }}</h1>


      <div style="margin-top: 2rem;">
        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{% render 'icon', name: 'alert', size: 18 %} {{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
            <input class="field__input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>
          </div>
          {%- if form.password_needed -%}
            <div class="field">
              <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
              <input class="field__input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
            </div>
            <p class="small"><a href="#RecoverForm">{{ 'customer.login.forgot_password' | t }}</a></p>
          {%- endif -%}
          <button type="submit" class="button button--full button--large">{{ 'customer.login.submit' | t }}</button>
        {%- endform -%}
        <p style="text-align: center; margin-top: 1.5rem;"><a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a></p>
      </div>

      <div style="margin-top: 2.5rem;">
        {%- form 'recover_customer_password', class: 'contact-card', id: 'RecoverForm' -%}
          <h2 class="h4">{{ 'customer.recover_password.title' | t }}</h2>
          <p class="small text-muted">{{ 'customer.recover_password.subtext' | t }}</p>
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">{% render 'icon', name: 'check', size: 18 %} {{ 'customer.recover_password.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field">
            <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input class="field__input" type="email" id="RecoverEmail" name="email" autocomplete="email" required>
          </div>
          <button type="submit" class="button button--secondary button--full">{{ 'customer.recover_password.submit' | t }}</button>
        {%- endform -%}
      </div>

      {%- if shop.checkout.guest_login -%}
        <hr>
        <h2 class="h4">{{ 'customer.login.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          <button type="submit" class="button button--secondary button--full">{{ 'customer.login.guest_continue' | t }}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Connexion client",
  "tag": "div",
  "settings": []
}
{% endschema %}
