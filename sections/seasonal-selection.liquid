{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
  if s.layout == 'feature' and count == 3
    assign tiles_class = 'tiles--feature'
  elsif count >= 3
    assign tiles_class = 'tiles--3'
  elsif count == 2
    assign tiles_class = 'tiles--2'
  else
    assign tiles_class = ''
  endif
-%}
{%- if count > 0 -%}
  <section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
    <div class="page-width">
      {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.heading_align %}
      <div class="tiles {{ tiles_class }} reveal">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign tile_tag = 'div'
            if b.link != blank
              assign tile_tag = 'a'
            endif
            case b.background
              when 'sage'
                assign tile_bg = 'var(--color-green)'
                assign tile_scheme = 'scheme-sage'
              when 'sage-light'
                assign tile_bg = 'var(--color-green-light)'
                assign tile_scheme = ''
              when 'ivory'
                assign tile_bg = 'var(--color-gray)'
                assign tile_scheme = ''
              when 'gold'
                assign tile_bg = 'var(--color-yellow)'
                assign tile_scheme = 'scheme-yellow'
              when 'red'
                assign tile_bg = 'var(--color-red)'
                assign tile_scheme = 'scheme-red'
              else
                assign tile_bg = 'var(--color-bg)'
                assign tile_scheme = ''
            endcase
          -%}
          <{{ tile_tag }}{% if b.link != blank %} href="{{ b.link }}"{% endif %} class="tile {{ tile_scheme }}{% if b.image != blank or b.show_placeholder %} tile--image{% endif %}" style="--tile-bg: {{ tile_bg }};" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              <div class="tile__img">
                {% render 'responsive-image', image: b.image, sizes: '(min-width: 750px) 50vw, 100vw', widths: '400,600,800,1000,1300' %}
              </div>
            {%- elsif b.show_placeholder -%}
              {%- liquid
                assign ph_n = forloop.index0 | modulo: 2 | plus: 1
                assign ph = 'lifestyle-' | append: ph_n
              -%}
              <div class="tile__img tile__img--placeholder" aria-hidden="true">{{ ph | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- endif -%}
            {%- if b.label != blank -%}<span class="tile__label">{{ b.label | escape }}</span>{%- endif -%}
            <h3 class="tile__title h2">{{ b.title | escape }}</h3>
            {%- if b.text != blank -%}<p class="tile__text">{{ b.text | escape }}</p>{%- endif -%}
            {%- if b.cta != blank and b.link != blank -%}
              <span class="tile__cta">{{ b.cta | escape }} {% render 'icon', name: 'arrow-right', size: 16 %}</span>
            {%- endif -%}
          </{{ tile_tag }}>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Sélection saisonnière",
  "tag": "div",
  "class": "section-seasonal",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Mettez en avant Noël, la rentrée, les idées cadeaux ou un événement. Masquez la section quand elle n'est plus d'actualité."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "En ce moment"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Les sélections <em>de saison</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement du titre",
      "options": [
        {
          "value": "left",
          "label": "À gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition (3 tuiles)",
      "options": [
        {
          "value": "feature",
          "label": "Une grande tuile et deux petites"
        },
        {
          "value": "columns",
          "label": "Colonnes égales"
        }
      ],
      "default": "feature"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        {
          "value": "offwhite",
          "label": "Blanc"
        },
        {
          "value": "white",
          "label": "Blanc pur"
        },
        {
          "value": "ivory",
          "label": "Gris clair"
        },
        {
          "value": "sage-light",
          "label": "Vert clair"
        },
        {
          "value": "yellow",
          "label": "Jaune"
        },
        {
          "value": "red",
          "label": "Rouge promo"
        }
      ],
      "default": "offwhite"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Marge haute",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Marge basse",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tuile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (facultative)"
        },
        {
          "type": "checkbox",
          "id": "show_placeholder",
          "label": "Image d'exemple tant qu'aucune image n'est choisie",
          "default": true
        },
        {
          "type": "select",
          "id": "background",
          "label": "Fond sans image",
          "options": [
            {
              "value": "sage-light",
              "label": "Vert clair"
            },
            {
              "value": "sage",
              "label": "Vert"
            },
            {
              "value": "ivory",
              "label": "Gris clair"
            },
            {
              "value": "gold",
              "label": "Jaune"
            },
            {
              "value": "offwhite",
              "label": "Blanc"
            }
          ],
          "default": "sage-light"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Étiquette",
          "default": "Idées cadeaux"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Faites-vous plaisir sans vous ruiner"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Libellé du lien",
          "default": "Découvrir"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sélection saisonnière",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "Idées cadeaux",
            "title": "Faites-vous plaisir sans vous ruiner",
            "background": "sage-light"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Maison",
            "title": "De belles découvertes, de petits prix",
            "background": "ivory"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Saison",
            "title": "Les pépites du moment",
            "background": "gold"
          }
        }
      ]
    }
  ]
}
{% endschema %}
