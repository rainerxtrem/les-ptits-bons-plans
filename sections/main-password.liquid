{%- assign brand_alt = settings.brand_name | default: shop.name -%}
<div class="password-page">
  <div class="password-page__inner">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 480 | image_tag: style: 'margin: 0 auto 2rem; width: 200px;', alt: brand_alt }}
    {%- else -%}
      <p class="h2" style="margin-bottom: 2rem;">{{ settings.brand_name | default: shop.name | escape }}</p>
    {%- endif -%}
    <p class="eyebrow" style="justify-content: center;">{{ 'password.eyebrow' | t }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="text-muted">{{ shop.password_message }}</p>
    {%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}

    <details style="margin-top: 3rem;">
      <summary class="link-button">{{ 'password.owner_login' | t }}</summary>
      {%- form 'storefront_password', class: 'contact-card', style: 'margin-top: 1rem;' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label class="field__label" for="StorePassword">{{ 'password.password' | t }}</label>
          <input class="field__input" type="password" name="password" id="StorePassword" autocomplete="current-password">
        </div>
        <button type="submit" class="button button--full">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Page de pré-lancement",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Les bonnes trouvailles <em>arrivent bientôt.</em>" }
  ]
}
{% endschema %}
