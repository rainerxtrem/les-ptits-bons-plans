{%- liquid
  assign blocks_count = section.blocks.size
  assign scheme = section.settings.color_scheme
-%}
{%- if blocks_count > 0 -%}
  <announcement-bar class="announcement scheme-{{ scheme }}" data-autoplay="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed }}{% else %}0{% endif %}" {{ section.shopify_attributes }}>
    <div class="page-width announcement__inner">
      {%- if blocks_count > 1 -%}
        <button type="button" class="icon-button announcement__nav" data-prev aria-label="{{ 'sections.announcement.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 16 %}</button>
      {%- endif -%}
      <div class="announcement__slider"{% if blocks_count > 1 %} data-rotating aria-roledescription="carousel"{% endif %}>
        {%- for block in section.blocks -%}
          <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if blocks_count > 1 -%}
        <button type="button" class="icon-button announcement__nav" data-next aria-label="{{ 'sections.announcement.next' | t }}">{% render 'icon', name: 'chevron-right', size: 16 %}</button>
        {%- if section.settings.autoplay -%}
          <button type="button" class="link-button small" data-pause aria-pressed="false">{{ 'sections.announcement.pause' | t }}</button>
        {%- endif -%}
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "tag": "div",
  "class": "announcement-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        {
          "value": "sage",
          "label": "Vert"
        },
        {
          "value": "sage-light",
          "label": "Vert clair"
        },
        {
          "value": "ivory",
          "label": "Gris clair"
        },
        {
          "value": "dark",
          "label": "Vert foncé"
        },
        {
          "value": "yellow",
          "label": "Jaune"
        },
        {
          "value": "red",
          "label": "Rouge promo"
        }
      ],
      "default": "yellow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Faire défiler automatiquement les messages",
      "info": "Un bouton « Pause » est alors proposé (accessibilité). Désactivé si le visiteur préfère réduire les animations.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Durée d'affichage",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Les pépites du moment sont arrivées",
          "info": "N'annoncez que des offres et conditions réellement configurées (livraison offerte, remise…)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
