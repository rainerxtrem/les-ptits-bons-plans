<section class="section scheme-offwhite" style="--pad-top: 64px; --pad-bottom: 88px;">
  <div class="page-width">
    <div class="account-box">
      <h1 class="h2" style="text-align: center;">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{% render 'icon', name: 'alert', size: 18 %} {{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input class="field__input" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{{ form.first_name }}">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input class="field__input" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{{ form.last_name }}">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }} <span class="required" aria-hidden="true">*</span></label>
          <input class="field__input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required aria-required="true" value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
        </div>
        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }} <span class="required" aria-hidden="true">*</span></label>
          <input class="field__input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required aria-required="true"{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
        </div>
        <div class="checkbox" style="margin-bottom: 1rem;">
          <input type="checkbox" class="checkbox__input" name="customer[accepts_marketing]" id="RegisterMarketing" value="true">
          <label for="RegisterMarketing" class="checkbox__label"><span class="checkbox__box" aria-hidden="true">{% render 'icon', name: 'check', size: 14 %}</span>{{ 'customer.register.marketing' | t }}</label>
        </div>
        <button type="submit" class="button button--full button--large">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}
      <p style="text-align: center; margin-top: 1.5rem;"><a href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a></p>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Création de compte", "tag": "div", "settings": [] }
{% endschema %}
