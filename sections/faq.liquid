{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width page-width--narrow">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: 'center' %}
    <div class="faq__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            <h3 class="faq__group-title h4" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</h3>
          {%- when 'question' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span class="accordion__summary-title">{{ block.settings.question | escape }}</span>
                <span class="accordion__toggle" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if s.contact_label != blank and s.contact_link != blank -%}
      <div class="empty-state" style="margin-top: 2.5rem;">
        {% render 'icon', name: 'chat', size: 28 %}
        <p>{{ s.contact_text | escape }}</p>
        <a href="{{ s.contact_link }}" class="button">{{ s.contact_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- liquid
  assign faq_count = 0
  for block in section.blocks
    if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank
      assign faq_count = faq_count | plus: 1
    endif
  endfor
-%}
{%- if faq_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
            {%- unless first -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
            }
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Questions fréquentes"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Tout savoir sur vos <em>commandes</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Texte d'aide",
      "default": "Vous ne trouvez pas votre réponse ?"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Libellé du bouton",
      "default": "Nous contacter"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Lien du bouton",
      "info": "Par exemple, votre page Contact."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        {
          "value": "offwhite",
          "label": "Blanc"
        },
        {
          "value": "white",
          "label": "Blanc pur"
        },
        {
          "value": "ivory",
          "label": "Gris clair"
        },
        {
          "value": "sage-light",
          "label": "Vert clair"
        },
        {
          "value": "yellow",
          "label": "Jaune"
        },
        {
          "value": "red",
          "label": "Rouge promo"
        }
      ],
      "default": "offwhite"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Marge haute",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Marge basse",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Thème de questions",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Commandes"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Comment passer commande ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Ajoutez les produits de votre choix au panier, puis cliquez sur « Passer commande » pour finaliser votre achat sur notre page de paiement sécurisée.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
