<div class="page-header page-header--center scheme-ivory">
  <div class="page-width">
    <p class="eyebrow">{{ 'blogs.eyebrow' | t }}</p>
    <h1 class="page-header__title">{{ blog.title | escape }}</h1>
  </div>
</div>
<section class="section scheme-offwhite" style="--pad-top: 48px; --pad-bottom: 72px;">
  <div class="page-width">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="grid" role="list" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: 3;">
          {%- for article in blog.articles -%}
            <li>
              <a href="{{ article.url }}" class="article-card">
                <div class="article-card__media">
                  {%- if article.image -%}
                    {% render 'responsive-image', image: article.image, sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', widths: '400,600,800,1000', alt: '' %}
                  {%- endif -%}
                </div>
                <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="article-card__title">{{ article.title | escape }}</h2>
                <p class="text-muted small" style="margin: 0;">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state"><p>{{ 'blogs.empty' | t }}</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
