{%- liquid
  assign s = section.settings
  case s.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '4 / 5'
  endcase
  assign col_sizes = '(min-width: 990px) calc(100vw / ' | append: s.columns_desktop | append: '), (min-width: 750px) 33vw, 50vw'
-%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      text: s.text,
      align: s.heading_align,
      link_label: s.link_label,
      link_url: s.link_url
    %}
    {%- if section.blocks.size > 0 -%}
      <ul class="grid reveal" role="list" style="--cols-mobile: {{ s.columns_mobile }}; --cols-tablet: {{ s.columns_desktop | at_most: 3 }}; --cols-desktop: {{ s.columns_desktop }}; --ratio: {{ ratio }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign title = block.settings.title | default: collection.title
            assign image = block.settings.image | default: collection.featured_image
            assign url = block.settings.link | default: collection.url
            if title == blank
              assign title = 'sections.category_grid.placeholder_title' | t
            endif
            assign placeholder_n = forloop.index0 | modulo: 6 | plus: 1
            assign placeholder_name = 'collection-' | append: placeholder_n
          -%}
          {%- if collection != blank or request.design_mode or block.settings.link != blank -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ url | default: routes.collections_url }}" class="category-card{% if s.card_style == 'overlay' %} category-card--overlay{% endif %}">
                <div class="category-card__media">
                  {%- if image != blank -%}
                    {% render 'responsive-image', image: image, sizes: col_sizes, widths: '300,450,600,800,1000', alt: '' %}
                  {%- else -%}
                    {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="category-card__body">
                  <div>
                    <h3 class="category-card__title">{{ title | escape }}</h3>
                    {%- if block.settings.text != blank -%}<p class="category-card__text">{{ block.settings.text | escape }}</p>{%- endif -%}
                  </div>
                  <span class="category-card__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 16 %}</span>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grille de catégories",
  "tag": "div",
  "class": "section-category-grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Explorer" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Trouvez votre <em>bon plan</em>" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement du titre",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Toutes les catégories" },
    { "type": "url", "id": "link_url", "label": "Lien", "default": "/collections" },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Colonnes sur ordinateur",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes sur mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Style des cartes",
      "options": [
        { "value": "below", "label": "Titre sous l'image" },
        { "value": "overlay", "label": "Titre sur l'image" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format des images",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Carré" },
        { "value": "landscape", "label": "Paysage" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "offwhite", "label": "Blanc cassé" },
        { "value": "white", "label": "Blanc" },
        { "value": "ivory", "label": "Beige ivoire" },
        { "value": "sage-light", "label": "Vert sauge très clair" },
        { "value": "sage", "label": "Vert sauge" },
        { "value": "dark", "label": "Vert foncé" }
      ],
      "default": "offwhite"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Facultatif : à défaut, l'image de la collection est utilisée." },
        { "type": "text", "id": "title", "label": "Titre", "info": "Facultatif : à défaut, le nom de la collection." },
        { "type": "text", "id": "text", "label": "Accroche" },
        { "type": "url", "id": "link", "label": "Lien personnalisé", "info": "Facultatif : remplace le lien vers la collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grille de catégories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
