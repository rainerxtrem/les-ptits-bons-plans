{%- liquid
  assign s = section.settings
  case s.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '4 / 5'
  endcase
-%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="editorial{% if s.image_position == 'right' %} editorial--media-right{% endif %}{% if s.wide_media %} editorial--wide-media{% endif %}{% if s.image_secondary != blank %} editorial--has-secondary{% endif %}">
      <div class="editorial__media reveal">
        {%- if s.show_accent -%}<span class="editorial__accent" aria-hidden="true"></span>{%- endif -%}
        <div class="editorial__frame" style="--ratio: {{ ratio }};">
          {%- if s.image != blank -%}
            {% render 'responsive-image', image: s.image, sizes: '(min-width: 750px) 50vw, 100vw', widths: '400,600,800,1000,1200,1500' %}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if s.image_secondary != blank -%}
          <div class="editorial__frame editorial__frame--secondary">
            {% render 'responsive-image', image: s.image_secondary, sizes: '(min-width: 750px) 20vw, 40vw', widths: '200,300,400,600' %}
          </div>
        {%- endif -%}
      </div>
      <div class="editorial__content reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.signature != blank -%}<p class="editorial__signature">{{ s.signature | escape }}</p>{%- endif -%}
        {%- liquid
          assign show_b1 = false
          assign show_b2 = false
          if s.button_label != blank and s.button_link != blank
            assign show_b1 = true
          endif
          if s.button_label_2 != blank and s.button_link_2 != blank
            assign show_b2 = true
          endif
        -%}
        {%- if show_b1 or show_b2 -%}
          <div class="editorial__buttons">
            {%- if s.button_label != blank and s.button_link != blank -%}
              <a href="{{ s.button_link }}" class="button">{{ s.button_label | escape }}</a>
            {%- endif -%}
            {%- if s.button_label_2 != blank and s.button_link_2 != blank -%}
              <a href="{{ s.button_link_2 }}" class="button button--secondary">{{ s.button_label_2 | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image et texte",
  "tag": "div",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image principale"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Image secondaire (facultative)",
      "info": "Petite image superposée pour une composition éditoriale."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image",
      "options": [
        {
          "value": "left",
          "label": "À gauche"
        },
        {
          "value": "right",
          "label": "À droite"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format de l'image",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Carré"
        },
        {
          "value": "landscape",
          "label": "Paysage"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "wide_media",
      "label": "Image plus large que le texte",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_accent",
      "label": "Cadre décoratif",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Notre esprit"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Le plaisir des <em>bonnes découvertes.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Une boutique pensée pour dénicher des produits intéressants, découvrir de nouvelles idées et profiter de prix avantageux.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature (facultative)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton principal",
      "default": "Découvrir la boutique"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton principal",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Bouton secondaire"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Lien du bouton secondaire"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        {
          "value": "offwhite",
          "label": "Blanc"
        },
        {
          "value": "white",
          "label": "Blanc pur"
        },
        {
          "value": "ivory",
          "label": "Gris clair"
        },
        {
          "value": "sage-light",
          "label": "Vert clair"
        },
        {
          "value": "sage",
          "label": "Vert"
        },
        {
          "value": "dark",
          "label": "Vert foncé"
        },
        {
          "value": "yellow",
          "label": "Jaune"
        },
        {
          "value": "red",
          "label": "Rouge promo"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Marge haute",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Marge basse",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Image et texte"
    }
  ]
}
{% endschema %}
