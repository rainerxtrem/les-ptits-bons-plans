{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'templates.404.title' | t
  endif
-%}
<section class="scheme-ivory">
  <div class="page-width page-width--narrow not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="h2">{{ heading | escape }}</h1>
    <p class="not-found__text">{{ 'templates.404.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="not-found__search search-modal__form">
      <div class="search-field">
        <label for="NotFoundSearch" class="visually-hidden">{{ 'search.label' | t }}</label>
        <span class="search-field__icon">{% render 'icon', name: 'search', size: 20 %}</span>
        <input type="search" id="NotFoundSearch" name="q" class="field__input search-field__input" placeholder="{{ 'search.placeholder' | t }}">
      </div>
      <button type="submit" class="button">{{ 'search.submit' | t }}</button>
    </form>
    <div class="not-found__actions">
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'templates.404.catalog' | t }}</a>
      <a href="{{ routes.root_url }}" class="button button--secondary">{{ 'templates.404.home' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page introuvable",
  "tag": "div",
  "class": "section-404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "info": "Par défaut : « Cette page s'est fait la malle. »" }
  ]
}
{% endschema %}
