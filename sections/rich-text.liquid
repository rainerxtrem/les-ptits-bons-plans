{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width page-width--narrow reveal" style="text-align: {{ s.align }};">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}{% if s.align == 'center' %} style="justify-content: center;"{% endif %}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="rte prose" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank and block.settings.link != blank -%}
            <p style="margin-top: 1.5rem;" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link }}" class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}">{{ block.settings.label | escape }}</a>
            </p>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "tag": "div",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Alignement",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "offwhite", "label": "Blanc cassé" },
        { "value": "white", "label": "Blanc" },
        { "value": "ivory", "label": "Beige ivoire" },
        { "value": "sage-light", "label": "Vert sauge très clair" },
        { "value": "sage", "label": "Vert sauge" },
        { "value": "dark", "label": "Vert foncé" }
      ],
      "default": "offwhite"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 64 }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Surtitre",
      "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Les p'tits bons plans" }]
    },
    {
      "type": "heading",
      "name": "Titre",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Vos envies, <em>nos bons plans.</em>" },
        {
          "type": "select",
          "id": "size",
          "label": "Taille",
          "options": [
            { "value": "h1", "label": "Grande" },
            { "value": "h2", "label": "Moyenne" },
            { "value": "h3", "label": "Petite" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Partagez ici l'esprit de votre boutique.</p>" }]
    },
    {
      "type": "button",
      "name": "Bouton",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Principal" },
            { "value": "secondary", "label": "Secondaire" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texte enrichi",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
