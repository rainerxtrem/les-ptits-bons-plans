<div class="field">
  <label class="field__label" for="NewPassword">{{ 'customer.reset.password' | t }}</label>
  <input class="field__input" type="password" name="customer[password]" id="NewPassword" autocomplete="new-password" required>
</div>
<div class="field">
  <label class="field__label" for="NewPasswordConfirm">{{ 'customer.reset.password_confirm' | t }}</label>
  <input class="field__input" type="password" name="customer[password_confirmation]" id="NewPasswordConfirm" autocomplete="new-password" required>
</div>
