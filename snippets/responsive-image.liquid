{%- comment -%}
  Image responsive avec srcset, dimensions et chargement différé.

  Paramètres :
  - image (obligatoire) : objet image Shopify
  - sizes : attribut sizes (défaut 100vw)
  - widths : liste de largeurs (défaut '360,540,720,900,1080,1296,1512,1728,2048')
  - class : classes CSS
  - alt : texte alternatif (défaut image.alt)
  - priority : true pour l'image principale au-dessus de la ligne de flottaison (eager + fetchpriority high)
{%- endcomment -%}
{%- liquid
  assign img_widths = widths | default: '360,540,720,900,1080,1296,1512,1728,2048'
  assign img_sizes = sizes | default: '100vw'
  assign img_alt = alt | default: image.alt | default: ''
  if priority
    assign img_loading = 'eager'
    assign img_priority = 'high'
  else
    assign img_loading = 'lazy'
    assign img_priority = 'auto'
  endif
-%}
{{-
  image
  | image_url: width: 2048
  | image_tag:
    widths: img_widths,
    sizes: img_sizes,
    alt: img_alt,
    class: class,
    loading: img_loading,
    fetchpriority: img_priority,
    decoding: 'async'
-}}
