{%- comment -%}
  Prix d'un produit ou d'une variante, à partir des données Shopify uniquement.
  Le prix barré n'est affiché que si un prix comparatif supérieur au prix est renseigné.

  Paramètres :
  - product (obligatoire)
  - variant : variante précise (fiche produit). Sans variante : rendu « carte » (« À partir de » si le prix varie).
  - size : 'large' pour la fiche produit
{%- endcomment -%}
{%- liquid
  if variant
    assign target = variant
    assign show_from = false
  else
    assign target = product.selected_or_first_available_variant
    assign show_from = product.price_varies
  endif

  if show_from
    assign price = product.price_min
    assign compare_at = nil
  else
    assign price = target.price
    assign compare_at = target.compare_at_price
  endif

  assign on_sale = false
  if compare_at and compare_at > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}{% if size == 'large' %} price--large{% endif %}">
  <span class="price__current">
    {%- if on_sale -%}<span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>{%- else -%}<span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{%- endif -%}
    {%- if show_from -%}
      {%- assign price_formatted = price | money -%}
      {{ 'products.product.price.from_price_html' | t: price: price_formatted }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">
      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
      {{ compare_at | money }}
    </s>
  {%- endif -%}
  {%- if target.unit_price_measurement and show_from == false -%}
    <span class="price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{ target.unit_price | money }}
      <span aria-hidden="true">/</span><span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
